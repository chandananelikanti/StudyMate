# StudyMate - Environment Variables Configuration

# OpenAI API Key (Required if using OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini API Key (Alternative if using Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Custom OpenAI Model (default: gpt-4o-mini)
# LLM_MODEL=gpt-4o-mini

# Optional: Custom API Base URL (for local or proxy endpoints)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server Settings
PORT=5000
FLASK_ENV=development
